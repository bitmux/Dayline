{
  "name": "day-spine-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card rendering today as one vertical spine",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && npm run stage",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "stage": "mkdir -p custom_components/day_spine/www && cp dist/day-spine-card.js custom_components/day_spine/www/day-spine-card.js"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "rollup": "^4.28.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
